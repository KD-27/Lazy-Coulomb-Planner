<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lazy_coulomb_planner</name>
  <version>1.0.0</version>
  <description>
    Lazy Coulomb Planner — a Nav2 global planner plugin that uses electrostatic
    repulsion to iteratively push path waypoints clear of obstacles. Starts with
    a straight line and resolves intersections one at a time, locking each cleared
    waypoint before moving to the next.
  </description>

  <maintainer email="kaveesha.d@hypeinvention.com">Kaveesha Dhananjaya</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
