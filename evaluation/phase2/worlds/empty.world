<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="empty_lcp">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- ======================== WALLS ========================
         22x22 m enclosed area, walls 0.2 m thick, 2 m tall.
         Wall centres sit at ±11.1 m so the inside face is at ±11 m. -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 11.1 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>22.4 0.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>22.4 0.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -11.1 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>22.4 0.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>22.4 0.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>11.1 0 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 22.0 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 22.0 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-11.1 0 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 22.0 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 22.0 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ======================== OBSTACLES ========================
         5 sparse obstacles, 1 m tall.
         3 cylinders (radius 0.4 m) + 2 boxes (1 x 1 m footprint).
         Positions chosen to spread across all four quadrants and
         leave the spawn region near origin clear. -->

    <model name="cyl_1">
      <static>true</static>
      <pose>5.0 4.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cyl_2">
      <static>true</static>
      <pose>-6.0 5.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cyl_3">
      <static>true</static>
      <pose>-4.0 -6.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_1">
      <static>true</static>
      <pose>6.5 -5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.8 0.4 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>0.0 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.8 0.4 0.3 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
