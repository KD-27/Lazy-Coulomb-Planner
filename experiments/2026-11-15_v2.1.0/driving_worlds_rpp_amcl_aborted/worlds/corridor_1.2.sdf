        <collision name="b11"><pose>19.9500 11.0000 0.25 0 0 0</pose><geometry><box><size>0.1000 1.2000 0.5</size></box></geometry></collision>
        <visual name="b11"><pose>19.9500 11.0000 0.25 0 0 0</pose><geometry><box><size>0.1000 1.2000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b12"><pose>3.2000 13.6000 0.25 0 0 0</pose><geometry><box><size>4.0000 4.0000 0.5</size></box></geometry></collision>
        <visual name="b12"><pose>3.2000 13.6000 0.25 0 0 0</pose><geometry><box><size>4.0000 4.0000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b13"><pose>13.6000 13.6000 0.25 0 0 0</pose><geometry><box><size>4.0000 4.0000 0.5</size></box></geometry></collision>
        <visual name="b13"><pose>13.6000 13.6000 0.25 0 0 0</pose><geometry><box><size>4.0000 4.0000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b14"><pose>8.4000 13.6000 0.25 0 0 0</pose><geometry><box><size>4.0000 4.0000 0.5</size></box></geometry></collision>
