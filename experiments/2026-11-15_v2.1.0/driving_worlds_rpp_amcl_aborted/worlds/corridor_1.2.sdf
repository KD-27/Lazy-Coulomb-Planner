        <collision name="b15"><pose>18.4000 13.6000 0.25 0 0 0</pose><geometry><box><size>3.2000 4.0000 0.5</size></box></geometry></collision>
        <visual name="b15"><pose>18.4000 13.6000 0.25 0 0 0</pose><geometry><box><size>3.2000 4.0000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b16"><pose>19.9500 16.2000 0.25 0 0 0</pose><geometry><box><size>0.1000 1.2000 0.5</size></box></geometry></collision>
        <visual name="b16"><pose>19.9500 16.2000 0.25 0 0 0</pose><geometry><box><size>0.1000 1.2000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b17"><pose>0.0500 10.0000 0.25 0 0 0</pose><geometry><box><size>0.1000 19.8000 0.5</size></box></geometry></collision>
        <visual name="b17"><pose>0.0500 10.0000 0.25 0 0 0</pose><geometry><box><size>0.1000 19.8000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b18"><pose>3.2000 18.3500 0.25 0 0 0</pose><geometry><box><size>4.0000 3.1000 0.5</size></box></geometry></collision>
        <visual name="b18"><pose>3.2000 18.3500 0.25 0 0 0</pose><geometry><box><size>4.0000 3.1000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b19"><pose>13.6000 18.3500 0.25 0 0 0</pose><geometry><box><size>4.0000 3.1000 0.5</size></box></geometry></collision>
        <visual name="b19"><pose>13.6000 18.3500 0.25 0 0 0</pose><geometry><box><size>4.0000 3.1000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b20"><pose>8.4000 18.3500 0.25 0 0 0</pose><geometry><box><size>4.0000 3.1000 0.5</size></box></geometry></collision>
        <visual name="b20"><pose>8.4000 18.3500 0.25 0 0 0</pose><geometry><box><size>4.0000 3.1000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b21"><pose>18.4000 18.3500 0.25 0 0 0</pose><geometry><box><size>3.2000 3.1000 0.5</size></box></geometry></collision>
        <visual name="b21"><pose>18.4000 18.3500 0.25 0 0 0</pose><geometry><box><size>3.2000 3.1000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b22"><pose>10.0000 19.9500 0.25 0 0 0</pose><geometry><box><size>20.0000 0.1000 0.5</size></box></geometry></collision>
        <visual name="b22"><pose>10.0000 19.9500 0.25 0 0 0</pose><geometry><box><size>20.0000 0.1000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
