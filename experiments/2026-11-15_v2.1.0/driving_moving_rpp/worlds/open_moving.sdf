<?xml version="1.0"?>
<!-- Gazebo world for the driving test on a generated map. Same plugins, light,
     ground and physics as Nav2's tb3_sandbox world (headless); the obstacles are
     filled in by generate_map.py (option sdf). -->
<sdf version="1.6">
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <scene><shadows>0</shadows></scene>
    <physics name="3ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <model name="obstacles">
      <static>1</static>
      <link name="link">
        <collision name="b0"><pose>10.0000 0.0500 0.25 0 0 0</pose><geometry><box><size>20.0000 0.1000 0.5</size></box></geometry></collision>
        <visual name="b0"><pose>10.0000 0.0500 0.25 0 0 0</pose><geometry><box><size>20.0000 0.1000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b1"><pose>0.0500 10.0000 0.25 0 0 0</pose><geometry><box><size>0.1000 19.8000 0.5</size></box></geometry></collision>
        <visual name="b1"><pose>0.0500 10.0000 0.25 0 0 0</pose><geometry><box><size>0.1000 19.8000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b2"><pose>19.9500 10.0000 0.25 0 0 0</pose><geometry><box><size>0.1000 19.8000 0.5</size></box></geometry></collision>
        <visual name="b2"><pose>19.9500 10.0000 0.25 0 0 0</pose><geometry><box><size>0.1000 19.8000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="b3"><pose>10.0000 19.9500 0.25 0 0 0</pose><geometry><box><size>20.0000 0.1000 0.5</size></box></geometry></collision>
        <visual name="b3"><pose>10.0000 19.9500 0.25 0 0 0</pose><geometry><box><size>20.0000 0.1000 0.5</size></box></geometry><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>
      <model name="mover_0">
      <pose>16.925 9.475 0.255 0 0 2.9860</pose>
      <link name="link">
        <inertial><mass>200.0</mass><inertia><ixx>7.292</ixx><iyy>7.292</iyy>
          <izz>6.250</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/mover_0/cmd_vel</topic>
      </plugin>
    </model>
    <model name="mover_1">
      <pose>9.825 16.975 0.255 0 0 2.6003</pose>
      <link name="link">
        <inertial><mass>200.0</mass><inertia><ixx>7.292</ixx><iyy>7.292</iyy>
          <izz>6.250</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/mover_1/cmd_vel</topic>
      </plugin>
    </model>
    <model name="mover_2">
      <pose>16.175 14.775 0.255 0 0 2.4770</pose>
      <link name="link">
        <inertial><mass>200.0</mass><inertia><ixx>7.292</ixx><iyy>7.292</iyy>
          <izz>6.250</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/mover_2/cmd_vel</topic>
      </plugin>
    </model>
    <model name="mover_3">
      <pose>1.125 2.925 0.255 0 0 0.4211</pose>
      <link name="link">
        <inertial><mass>200.0</mass><inertia><ixx>7.292</ixx><iyy>7.292</iyy>
          <izz>6.250</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/mover_3/cmd_vel</topic>
      </plugin>
    </model>
    <model name="mover_4">
      <pose>9.875 0.925 0.255 0 0 0.8809</pose>
      <link name="link">
        <inertial><mass>200.0</mass><inertia><ixx>7.292</ixx><iyy>7.292</iyy>
          <izz>6.250</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/mover_4/cmd_vel</topic>
      </plugin>
    </model>
    <model name="mover_5">
      <pose>12.625 14.725 0.255 0 0 3.0811</pose>
      <link name="link">
        <inertial><mass>200.0</mass><inertia><ixx>7.292</ixx><iyy>7.292</iyy>
          <izz>6.250</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/mover_5/cmd_vel</topic>
      </plugin>
    </model>
  </world>
</sdf>
